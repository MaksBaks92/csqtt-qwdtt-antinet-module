{
  "apiVersion": 1,
  "schemes": [
    "csqtt",
    "qwdtt"
  ],
  "names": [
    "CSQTT",
    "qWDTT"
  ],
  "name": "CSQTT / qWDTT",
  "description": "Два протокола в одном модуле: csqtt:// и qwdtt://. Общие только таймаут и Device ID; всё остальное — в раскрываемых блоках CSQTT и qWDTT без пересечений.",
  "homepage": "https://github.com/MaksBaks92/csqtt-qwdtt-antinet-module",
  "updateUrl": "https://raw.githubusercontent.com/MaksBaks92/csqtt-qwdtt-antinet-module/main/antinet-module.json",
  "version": "0.2.19-dual",
  "license": "GPL-3.0-or-later (combined helper); CSQTT portions PolyForm-Noncommercial — see NOTICE",
  "handoverMode": "signal",
  "hostEvents": [
    "handover",
    "netlost",
    "netback",
    "stall",
    "dns"
  ],
  "parallelPing": true,
  "pingNeedsConsent": true,
  "pingTimeoutSec": 90,
  "pingWhileConnected": true,
  "socks5": true,
  "dnsResolver": true,
  "relayWindowSec": 15,
  "settings": [
    {
      "key": "dialTimeoutSec",
      "type": "int",
      "label": "Таймаут дозвона (сек)",
      "default": 20,
      "min": 1,
      "max": 120,
      "description": "Потолок dial до цели внутри туннеля (обе схемы)."
    },
    {
      "key": "deviceId",
      "type": "string",
      "label": "Device ID",
      "default": "",
      "description": "Пусто — HWID AntiNet. Общий для привязки пароля."
    },
    {
      "key": "panelCsqtt",
      "type": "bool",
      "label": "CSQTT",
      "default": false,
      "description": "Раскрыть настройки протокола csqtt://"
    },
    {
      "key": "csqttWorkers",
      "type": "slider",
      "label": "Воркеры CSQTT",
      "default": 18,
      "min": 9,
      "max": 72,
      "step": 9,
      "description": "TURN-воркеры для csqtt://. Кратно 9.",
      "visibleWhen": {
        "key": "panelCsqtt",
        "in": ["true"]
      }
    },
    {
      "key": "csqttHashMode",
      "type": "enum",
      "label": "Режим хешей CSQTT",
      "default": "auto_api",
      "description": "Ручной — поля хешей ниже. Авто API / Авто ВК — helper создаёт звонки сам.",
      "options": [
        { "value": "manual", "label": "Ручной" },
        { "value": "auto_api", "label": "Авто API" },
        { "value": "auto_js", "label": "Авто ВК" }
      ],
      "visibleWhen": {
        "key": "panelCsqtt",
        "in": ["true"]
      }
    },
    {
      "key": "csqttHash1",
      "type": "string",
      "label": "CSQTT VK-хеш 1",
      "default": "",
      "description": "Ссылка vk.com/call/join/… или хеш.",
      "visibleWhen": {
        "key": "csqttHashMode",
        "in": ["manual"]
      }
    },
    {
      "key": "csqttHash2",
      "type": "string",
      "label": "CSQTT VK-хеш 2",
      "default": "",
      "description": "Необязательно.",
      "visibleWhen": {
        "key": "csqttHashMode",
        "in": ["manual"]
      }
    },
    {
      "key": "csqttHash3",
      "type": "string",
      "label": "CSQTT VK-хеш 3",
      "default": "",
      "description": "Необязательно.",
      "visibleWhen": {
        "key": "csqttHashMode",
        "in": ["manual"]
      }
    },
    {
      "key": "csqttHash4",
      "type": "string",
      "label": "CSQTT VK-хеш 4",
      "default": "",
      "description": "Необязательно.",
      "visibleWhen": {
        "key": "csqttHashMode",
        "in": ["manual"]
      }
    },
    {
      "key": "csqttAuthMode",
      "type": "enum",
      "label": "Креды / VK auth CSQTT",
      "default": "vkcalls",
      "description": "Только csqtt://: Авто (VK Calls) / Авто ВК / Капча.",
      "options": [
        { "value": "vkcalls", "label": "Авто (VK Calls)" },
        { "value": "auto_js", "label": "Авто ВК" },
        { "value": "legacy", "label": "Капча / Legacy" }
      ],
      "visibleWhen": {
        "key": "panelCsqtt",
        "in": ["true"]
      }
    },
    {
      "key": "idleWorkers",
      "type": "int",
      "label": "Воркеров в простое",
      "default": 2,
      "min": 0,
      "max": 72,
      "description": "0 — выключить deep idle.",
      "visibleWhen": {
        "key": "panelCsqtt",
        "in": ["true"]
      }
    },
    {
      "key": "idleAfterSec",
      "type": "int",
      "label": "Простой через (сек)",
      "default": 180,
      "min": 30,
      "max": 3600,
      "description": "Через сколько секунд без трафика уходить в idle.",
      "visibleWhen": {
        "key": "panelCsqtt",
        "in": ["true"]
      }
    },
    {
      "key": "obfs",
      "type": "enum",
      "label": "Обфускация",
      "default": "audio",
      "description": "Тип RTP-обфускации CSQTT.",
      "options": [
        { "value": "audio", "label": "Audio" },
        { "value": "video", "label": "Video" }
      ],
      "visibleWhen": {
        "key": "panelCsqtt",
        "in": ["true"]
      }
    },
    {
      "key": "turnTransport",
      "type": "enum",
      "label": "TURN CSQTT",
      "default": "udp",
      "description": "TCP — если режут UDP.",
      "options": [
        { "value": "udp", "label": "UDP" },
        { "value": "tcp_tls", "label": "TCP" }
      ],
      "visibleWhen": {
        "key": "panelCsqtt",
        "in": ["true"]
      }
    },
    {
      "key": "fecDuplicate",
      "type": "bool",
      "label": "FEC мелкого UDP",
      "default": true,
      "description": "Дублирование мелких UDP-пакетов.",
      "visibleWhen": {
        "key": "panelCsqtt",
        "in": ["true"]
      }
    },
    {
      "key": "debugLog",
      "type": "bool",
      "label": "Подробный лог CSQTT",
      "default": false,
      "description": "Диагностика gVisor/bridge.",
      "visibleWhen": {
        "key": "panelCsqtt",
        "in": ["true"]
      }
    },
    {
      "key": "panelQwdtt",
      "type": "bool",
      "label": "qWDTT",
      "default": false,
      "description": "Раскрыть настройки протокола qwdtt://"
    },
    {
      "key": "qwdttWorkers",
      "type": "slider",
      "label": "Воркеры qWDTT",
      "default": 18,
      "min": 9,
      "max": 72,
      "step": 9,
      "description": "TURN-воркеры для qwdtt://. Кратно 9.",
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "qwdttHashMode",
      "type": "enum",
      "label": "Режим хешей qWDTT",
      "default": "auto_api",
      "description": "Ручной — поля хешей ниже. Авто API — helper создаёт звонки сам. Авто ВК мапится в Авто API.",
      "options": [
        { "value": "manual", "label": "Ручной" },
        { "value": "auto_api", "label": "Авто API" },
        { "value": "auto_js", "label": "Авто ВК → API" }
      ],
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "qwdttHash1",
      "type": "string",
      "label": "qWDTT VK-хеш 1",
      "default": "",
      "description": "Ссылка vk.com/call/join/… или хеш.",
      "visibleWhen": {
        "key": "qwdttHashMode",
        "in": ["manual"]
      }
    },
    {
      "key": "qwdttHash2",
      "type": "string",
      "label": "qWDTT VK-хеш 2",
      "default": "",
      "description": "Необязательно.",
      "visibleWhen": {
        "key": "qwdttHashMode",
        "in": ["manual"]
      }
    },
    {
      "key": "qwdttHash3",
      "type": "string",
      "label": "qWDTT VK-хеш 3",
      "default": "",
      "description": "Необязательно.",
      "visibleWhen": {
        "key": "qwdttHashMode",
        "in": ["manual"]
      }
    },
    {
      "key": "qwdttHash4",
      "type": "string",
      "label": "qWDTT VK-хеш 4",
      "default": "",
      "description": "Необязательно.",
      "visibleWhen": {
        "key": "qwdttHashMode",
        "in": ["manual"]
      }
    },
    {
      "key": "qwdttAuthMode",
      "type": "enum",
      "label": "VK auth qWDTT",
      "default": "anonymous",
      "description": "Только qwdtt://: анонимно или через аккаунт.",
      "options": [
        { "value": "anonymous", "label": "Анонимно" },
        { "value": "account", "label": "Через VK-аккаунт" }
      ],
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "captchaMode",
      "type": "enum",
      "label": "Капча VK",
      "default": "auto",
      "description": "Как решать VK-капчу при получении TURN (qWDTT).",
      "options": [
        { "value": "auto", "label": "Авто" },
        { "value": "rjs", "label": "Go → webview" },
        { "value": "wv", "label": "Только webview" }
      ],
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "vkAnonPath",
      "type": "enum",
      "label": "Анонимный путь VK",
      "default": "vkcalls",
      "description": "Источник анонимных TURN-кредов (qWDTT).",
      "options": [
        { "value": "vkcalls", "label": "VK Calls" },
        { "value": "legacy", "label": "Legacy token" }
      ],
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "dnsPreset",
      "type": "enum",
      "label": "DNS для VK",
      "default": "yandex",
      "description": "DNS цепочки подключения qWDTT (не туннельный DNS).",
      "options": [
        { "value": "yandex", "label": "Яндекс" },
        { "value": "cloudflare", "label": "Cloudflare" },
        { "value": "google", "label": "Google" },
        { "value": "doh-cloudflare", "label": "Cloudflare DoH" },
        { "value": "doh-google", "label": "Google DoH" }
      ],
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "connMode",
      "type": "enum",
      "label": "Транспорт",
      "default": "vpn",
      "description": "Raw IP требует -listen-raw на VPS.",
      "options": [
        { "value": "vpn", "label": "WireGuard" },
        { "value": "rawtun", "label": "Raw IP" }
      ],
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "noDtls",
      "type": "bool",
      "label": "Без DTLS",
      "default": false,
      "description": "Нужен -listen-direct на сервере.",
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "turnTcp",
      "type": "bool",
      "label": "TURN по TCP",
      "default": false,
      "description": "TCP вместо UDP для TURN.",
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "directPort",
      "type": "int",
      "label": "Порт без DTLS",
      "default": 56002,
      "min": 1,
      "max": 65535,
      "description": "Используется только если включено «Без DTLS».",
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    },
    {
      "key": "rawPort",
      "type": "int",
      "label": "Порт Raw IP",
      "default": 56003,
      "min": 1,
      "max": 65535,
      "description": "Используется только в режиме Raw IP.",
      "visibleWhen": {
        "key": "panelQwdtt",
        "in": ["true"]
      }
    }
  ],
  "helperBinary": {
    "android": "libdualhelper.so",
    "desktop": "dual-helper"
  },
  "build": {
    "goDir": "native/dual",
    "goPkg": "./cmd/helper",
    "ldflags": "-checklinkname=0",
    "rustDir": "../modulecsqtt/native/csqtt-engine"
  }
}
