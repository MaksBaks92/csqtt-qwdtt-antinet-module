{
  "apiVersion": 1,
  "schemes": [
    "csqtt",
    "qwdtt"
  ],
  "names": [
    "CSQTT",
    "qWDTT"
  ],
  "name": "CSQTT / qWDTT",
  "description": "Два протокола в одном модуле: csqtt:// → сервер CSQTT (WIRE-3), qwdtt:// → VPS qWDTT (WG/raw). Общий слой VK-хешей/TURN. В UI AntiNet настройки с schemes=[csqtt] видны только у csqtt://, с schemes=[qwdtt] — только у qwdtt://; общие — у обеих. Хеши VK показываются только в режиме «Ручной».",
  "homepage": "https://github.com/MaksBaks92/csqtt-qwdtt-antinet-module",
  "updateUrl": "https://raw.githubusercontent.com/MaksBaks92/csqtt-qwdtt-antinet-module/main/antinet-module.json",
  "version": "0.2.11-dual",
  "license": "GPL-3.0-or-later (combined helper); CSQTT portions PolyForm-Noncommercial — see NOTICE",
  "handoverMode": "signal",
  "hostEvents": [
    "handover",
    "netlost",
    "netback",
    "stall",
    "dns"
  ],
  "parallelPing": true,
  "pingNeedsConsent": true,
  "pingTimeoutSec": 90,
  "pingWhileConnected": true,
  "socks5": true,
  "dnsResolver": true,
  "relayWindowSec": 15,
  "settings": [
    {
      "key": "dialTimeoutSec",
      "type": "int",
      "label": "Таймаут дозвона (сек)",
      "default": 20,
      "min": 1,
      "max": 120,
      "description": "Потолок dial до цели внутри туннеля (обе схемы)."
    },
    {
      "key": "workers",
      "type": "slider",
      "label": "Число TURN-воркеров",
      "default": 18,
      "min": 9,
      "max": 72,
      "step": 9,
      "description": "Обе схемы. Кратно 9 (группы по 9). Больше — запас по обрывам, выше нагрузка на VK/TURN. Берётся только эта настройка; workers= в ссылке игнорируется.",
      "schemes": [
        "csqtt",
        "qwdtt"
      ]
    },
    {
      "key": "hashMode",
      "type": "enum",
      "label": "Режим хешей VK",
      "default": "manual",
      "description": "Ручной — поля хешей ниже. Авто API / Авто ВК — helper создаёт звонки сам (поля хешей скрыты). Для qWDTT без hashes= в ссылке — Авто API создаёт свои звонки (нужен вход в VK).",
      "options": [
        {
          "value": "manual",
          "label": "Ручной"
        },
        {
          "value": "auto_api",
          "label": "Авто API"
        },
        {
          "value": "auto_js",
          "label": "Авто ВК"
        }
      ],
      "schemes": [
        "csqtt",
        "qwdtt"
      ]
    },
    {
      "key": "vkHash1",
      "type": "string",
      "label": "VK-хеш 1",
      "default": "",
      "description": "Ссылка vk.com/call/join/… или сам хеш. Для CSQTT (hashMode=manual) и запасной для qWDTT.",
      "visibleWhen": {
        "key": "hashMode",
        "in": [
          "manual"
        ]
      },
      "schemes": [
        "csqtt",
        "qwdtt"
      ]
    },
    {
      "key": "vkHash2",
      "type": "string",
      "label": "VK-хеш 2",
      "default": "",
      "description": "Необязательно.",
      "visibleWhen": {
        "key": "hashMode",
        "in": [
          "manual"
        ]
      },
      "schemes": [
        "csqtt",
        "qwdtt"
      ]
    },
    {
      "key": "vkHash3",
      "type": "string",
      "label": "VK-хеш 3",
      "default": "",
      "description": "Необязательно.",
      "visibleWhen": {
        "key": "hashMode",
        "in": [
          "manual"
        ]
      },
      "schemes": [
        "csqtt",
        "qwdtt"
      ]
    },
    {
      "key": "vkHash4",
      "type": "string",
      "label": "VK-хеш 4",
      "default": "",
      "description": "Необязательно.",
      "visibleWhen": {
        "key": "hashMode",
        "in": [
          "manual"
        ]
      },
      "schemes": [
        "csqtt",
        "qwdtt"
      ]
    },
    {
      "key": "vkAuthMode",
      "type": "enum",
      "label": "Режим кредов / VK auth",
      "default": "vkcalls",
      "description": "CSQTT: Авто / Авто ВК / Капча. qWDTT: anonymous≈Авто, account≈вход в VK (см. опции).",
      "options": [
        {
          "value": "vkcalls",
          "label": "Авто (VK Calls)"
        },
        {
          "value": "auto_js",
          "label": "Авто ВК (CSQTT)"
        },
        {
          "value": "legacy",
          "label": "Капча / Legacy (CSQTT; для qWDTT ≈ Legacy token)"
        },
        {
          "value": "anonymous",
          "label": "Анонимно (qWDTT)"
        },
        {
          "value": "account",
          "label": "Через VK-аккаунт (qWDTT)"
        }
      ]
    },
    {
      "key": "deviceId",
      "type": "string",
      "label": "Device ID",
      "default": "",
      "description": "Пусто — HWID AntiNet. Общий для привязки пароля на серверах."
    },
    {
      "key": "debugLog",
      "type": "bool",
      "label": "Подробный лог",
      "default": false,
      "description": "Диагностика (в основном CSQTT gVisor/bridge)."
    },
    {
      "key": "idleWorkers",
      "type": "int",
      "label": "CSQTT воркеров в простое",
      "default": 2,
      "min": 0,
      "max": 72,
      "description": "Только csqtt://. 0 — выключить deep idle.",
      "schemes": [
        "csqtt"
      ]
    },
    {
      "key": "idleAfterSec",
      "type": "int",
      "label": "CSQTT простой через (сек)",
      "default": 180,
      "min": 30,
      "max": 3600,
      "description": "Только csqtt://.",
      "schemes": [
        "csqtt"
      ]
    },
    {
      "key": "obfs",
      "type": "enum",
      "label": "Обфускация CSQTT",
      "default": "audio",
      "description": "Только csqtt://.",
      "options": [
        {
          "value": "audio",
          "label": "Audio"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "schemes": [
        "csqtt"
      ]
    },
    {
      "key": "turnTransport",
      "type": "enum",
      "label": "TURN CSQTT",
      "default": "udp",
      "description": "Только csqtt://. TCP — если режут UDP.",
      "options": [
        {
          "value": "udp",
          "label": "UDP"
        },
        {
          "value": "tcp_tls",
          "label": "TCP"
        }
      ],
      "schemes": [
        "csqtt"
      ]
    },
    {
      "key": "fecDuplicate",
      "type": "bool",
      "label": "FEC мелкого UDP (CSQTT)",
      "default": true,
      "description": "Только csqtt://.",
      "schemes": [
        "csqtt"
      ]
    },
    {
      "key": "captchaMode",
      "type": "enum",
      "label": "Капча VK (qWDTT)",
      "default": "auto",
      "description": "Только qwdtt://.",
      "options": [
        {
          "value": "auto",
          "label": "Авто"
        },
        {
          "value": "rjs",
          "label": "Go → webview"
        },
        {
          "value": "wv",
          "label": "Только webview"
        }
      ],
      "schemes": [
        "qwdtt"
      ]
    },
    {
      "key": "vkAnonPath",
      "type": "enum",
      "label": "Анонимный путь VK (qWDTT)",
      "default": "vkcalls",
      "description": "Только qwdtt://.",
      "options": [
        {
          "value": "vkcalls",
          "label": "VK Calls"
        },
        {
          "value": "legacy",
          "label": "Legacy token (getAnonymousToken)"
        }
      ],
      "schemes": [
        "qwdtt"
      ]
    },
    {
      "key": "dnsPreset",
      "type": "enum",
      "label": "DNS для VK (qWDTT)",
      "default": "yandex",
      "description": "Только цепочка подключения qWDTT, не туннельный DNS.",
      "options": [
        {
          "value": "yandex",
          "label": "Яндекс"
        },
        {
          "value": "cloudflare",
          "label": "Cloudflare"
        },
        {
          "value": "google",
          "label": "Google"
        },
        {
          "value": "doh-cloudflare",
          "label": "Cloudflare DoH"
        },
        {
          "value": "doh-google",
          "label": "Google DoH"
        }
      ],
      "schemes": [
        "qwdtt"
      ]
    },
    {
      "key": "connMode",
      "type": "enum",
      "label": "Транспорт qWDTT",
      "default": "vpn",
      "description": "Только qwdtt://. Raw IP требует -listen-raw на VPS.",
      "options": [
        {
          "value": "vpn",
          "label": "WireGuard"
        },
        {
          "value": "rawtun",
          "label": "Raw IP"
        }
      ],
      "schemes": [
        "qwdtt"
      ]
    },
    {
      "key": "noDtls",
      "type": "bool",
      "label": "Без DTLS (qWDTT)",
      "default": false,
      "description": "Только qwdtt://. Нужен -listen-direct на сервере.",
      "schemes": [
        "qwdtt"
      ]
    },
    {
      "key": "turnTcp",
      "type": "bool",
      "label": "TURN по TCP (qWDTT)",
      "default": false,
      "description": "Только qwdtt://.",
      "schemes": [
        "qwdtt"
      ]
    },
    {
      "key": "directPort",
      "type": "int",
      "label": "Порт без DTLS (qWDTT)",
      "default": 56002,
      "min": 1,
      "max": 65535,
      "description": "Только если «Без DTLS».",
      "visibleWhen": {
        "key": "noDtls",
        "in": [
          "true"
        ]
      },
      "schemes": [
        "qwdtt"
      ]
    },
    {
      "key": "rawPort",
      "type": "int",
      "label": "Порт Raw IP (qWDTT)",
      "default": 56003,
      "min": 1,
      "max": 65535,
      "description": "Только режим Raw IP.",
      "visibleWhen": {
        "key": "connMode",
        "in": [
          "rawtun"
        ]
      },
      "schemes": [
        "qwdtt"
      ]
    }
  ],
  "helperBinary": {
    "android": "libdualhelper.so",
    "desktop": "dual-helper"
  },
  "build": {
    "goDir": "native/dual",
    "goPkg": "./cmd/helper",
    "ldflags": "-checklinkname=0",
    "rustDir": "../modulecsqtt/native/csqtt-engine"
  }
}
